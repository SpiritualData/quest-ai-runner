# quest-ai-runner — example environment.
# Copy to `.env`, fill in real values, and load it (e.g. `set -a && . ./.env && set +a`).
# NEVER commit your real `.env` — it is gitignored. This file ships ONLY placeholders.

# --- Quest connection (required) ---
QUEST_BASE_URL=https://api.example.org      # your Quest API base URL
QUEST_API_KEY=qsk_replace_me                # the executor identity; keep this secret
QUEST_TEAM_ID=team_replace_me               # the team this lane serves (task claiming/escalation)
# QUEST_ORG_ID=org_replace_me                 # optional: registers the environment heartbeat at
                                             # ORG scope instead of team scope, making this runner
                                             # available to every team in the org, not just
                                             # QUEST_TEAM_ID above (which is still required)

# --- Model provider ---
# QAR_MODEL_BACKEND selects the planner/answer backend:
#   anthropic   — the SDK-based AnthropicProvider; needs ANTHROPIC_API_KEY (per-token billing).
#   claude_cli  — KEYLESS: drives the local `claude` CLI on this box's Claude Code SUBSCRIPTION
#                 login. No API key needed. (The deep-runner already runs keyless this way.)
# Leave it BLANK to auto-select: claude_cli when no ANTHROPIC_API_KEY is set, else anthropic.
QAR_MODEL_BACKEND=                           # anthropic | claude_cli | (blank = auto)
ANTHROPIC_API_KEY=                           # only for the "anthropic" backend; leave blank to run keyless
QAR_ANSWER_TIMEOUT=                          # claude_cli planner/answer per-call cap, seconds (default 180)
QAR_PLANNER_TIER=                            # planner step model tier (default haiku; e.g. sonnet for edit-heavy work)
QAR_VERIFY_TIER=                             # goal/claims verification judge tier (default best; e.g. balanced to cheapen)

# --- Overseer: the minimal-intervention run judge (optional; off by default) ---
QAR_OVERSEER=                                # 1/true enables the overseer (non-blocking, capped, degrades to proceed)
QAR_OVERSEER_TIER=                           # overseer model tier (default best; its digest keeps token cost tiny)
QAR_OVERSEER_MAX_SIGNALS=                    # hard cap on overseer consultations per run (default 3)

# --- Grounding & deep execution (optional) ---
QAR_CORPUS_ROOT=/path/to/your/corpus        # file root the FilesAdapter grounds on (read-only)
QAR_CLAUDE_PATH=claude                       # deep-runner worker binary (default: claude on PATH)
QAR_DEEP_WORKING_DIR=/path/to/your/corpus    # working dir for the subprocess deep-runner (CLI)

# --- Routing & labeling (optional) ---
QAR_DECISION_ASSIGNEE=                       # user id that human-only decisions route to
QAR_CONTEXT_PREAMBLE=                        # org/persona context prepended to every deep-run brief
QAR_CONTEXT_CARDS_DIR=                       # ContextAssembler cards dir (default <corpus>/.quest-context; empty disables). Gitignore it.
QAR_RECENT_CONTEXT=                          # 1/true (default) keeps the warm recent-turn card fallback on; 0/false disables it
QAR_RECENT_CONTEXT_MAX_CARDS=                # cap on recent-turn cards let through per turn (default 6)
QAR_RECENT_CONTEXT_GLOBAL=                   # 1/true (default) keeps the "global" (cross-conversation/quest) recent-context scope on; 0/false disables it only
QAR_RUNNER_LABEL=example-runner             # human-readable tag on the env heartbeat
QAR_ENV_ID=                                  # which of the team's envs this runner is (blank = default;
                                            # set a distinct id per runner when a team attaches several)

# --- Web search (optional; ON by default, no extra key needed) ---
# The runner grounds answers on the live web using the model provider's NATIVE tool (Claude's
# web_search / Gemini's Google Search grounding), reusing the LLM key above. Nothing to set to use
# it. Set WEB_SEARCH_ENABLED=false to disable. See docs/web-search.md.
# WEB_SEARCH_ENABLED=false                    # opt out of web search entirely
# WEB_SEARCH_TIER=balanced                    # model tier for native web search (fast|balanced|quality|best)
# WEB_SEARCH_MAX_RESULTS=5                     # max sources/searches per query
# WEB_SEARCH_API_KEY=tvly_xxx                 # optional: use Tavily instead of native provider search

# --- Runner tuning (optional) ---
QAR_STATE_PATH=qar_state.json               # signature dedup store path
QAR_POLL_INTERVAL=900                        # poll loop cadence, seconds
QAR_MAX_CONSECUTIVE_READS=20                 # planner read-loop limit before escalating to deep
                                            # (default 20; higher = more exploration before escalation)

# --- Resource-aware throttling (optional; all blank = disabled) ---
# When any limit is set, the runner PAUSES picking up new tasks while the host is overloaded and
# resumes automatically once resources recover. Pausing is lossless: unclaimed tasks stay queued
# on the backend and run on a later scan; in-flight tasks are never killed.
QAR_MAX_MEMORY_PERCENT=                      # pause when system memory usage exceeds this % (e.g. 90)
QAR_MIN_FREE_MEMORY_MB=                      # pause when available memory drops below this many MB
QAR_MAX_LOAD_PER_CORE=                       # pause when 1-min load average per CPU core exceeds this (e.g. 2.0)
QAR_RESOURCE_RESUME_MARGIN=10                # hysteresis: clear a tripped limit by this % before resuming
QAR_RESOURCE_CHECK_INTERVAL=30               # seconds between re-checks while paused

# --- Daily token budget (default: 2,000,000 tokens/day) ---
# Caps total shallow API tokens (input + output) per UTC day. Prevents runaway costs from
# indexing and context operations. The deep-runner (Claude Code, subscription) is NOT counted.
# When the limit is hit, the poller pauses and in-flight chat turns return a helpful message.
# Default (unset): 2M tokens/day (~$0.15 Gemini Flash, ~$1.60 Haiku, ~$6 Sonnet).
# Override to raise the cap, or set to 0/"off" to disable entirely.
QAR_DAILY_TOKEN_LIMIT=2000000              # tokens/day; set to 0 or "off" to disable
# QAR_DAILY_USAGE_PATH=qar_daily_usage.json  # where today's count is persisted (gitignored)
