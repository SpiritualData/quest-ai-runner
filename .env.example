# quest-ai-runner — example environment.
# Copy to `.env`, fill in real values, and load it (e.g. `set -a && . ./.env && set +a`).
# NEVER commit your real `.env` — it is gitignored. This file ships ONLY placeholders.

# --- Quest connection (required) ---
# QUEST_BASE_URL (your Quest API base URL), QUEST_API_KEY (the executor identity, qsk_..., a secret) and QUEST_TEAM_ID (the lane's HOME
# team: task claiming, escalation, heartbeat; required for a lane) are in the generated block below.
# QUEST_TEAM_IDS=team_a,team_b                # optional: the SET of teams this ONE lane discovers
                                             # work from. Unset = single-team mode, exactly as
                                             # before. QUEST_TEAM_ID stays the home team and
                                             # is still required. QAR_DISCOVERY_TEAM_ID, when set
                                             # at all (including ""), wins over this.
# QUEST_ORG_ID=org_replace_me                 # optional: registers the environment heartbeat at
                                             # ORG scope instead of team scope, making this runner
                                             # available to every team in the org, not just
                                             # QUEST_TEAM_ID (which is still required)

# --- Model provider ---
# QAR_MODEL_BACKEND selects the planner/answer backend:
#   anthropic   — the SDK-based AnthropicProvider; needs ANTHROPIC_API_KEY (per-token billing).
#   claude_cli  — KEYLESS: drives the local `claude` CLI on this box's Claude Code SUBSCRIPTION
#                 login. No API key needed. (The deep-runner already runs keyless this way.)
# Leave it BLANK to auto-select, Anthropic first: claude_cli when the `claude` executable is on the path, else anthropic
# (ANTHROPIC_API_KEY), then gemini (GOOGLE_API_KEY), then openai (OPENAI_API_KEY).
QAR_MODEL_BACKEND=                           # anthropic | claude_cli | (blank = auto)
# QAR_ANTHROPIC_THINKING=on                  # anthropic backend only: opt back in to extended thinking (default off)
# Vendor API keys (ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY, DEEPSEEK_API_KEY and their base URLs) are declared by the hub:
# see the generated block at the end of this file. Leave them blank to run keyless on claude_cli.
QAR_ANSWER_TIMEOUT=                          # claude_cli planner/answer per-call cap, seconds (default 180)
QAR_PLANNER_TIER=                            # planner step model tier (default haiku; e.g. sonnet for edit-heavy work)
QAR_VERIFY_TIER=                             # goal/claims verification judge tier (default best; e.g. balanced to cheapen)

# --- Overseer: the minimal-intervention run judge (ON by default) ---
QAR_OVERSEER=                                # 0/false DISABLES it (on by default; non-blocking, capped, degrades to proceed)
QAR_OVERSEER_TIER=                           # overseer model tier (default best; its digest keeps token cost tiny)
QAR_OVERSEER_MAX_SIGNALS=                    # hard cap on overseer consultations per run (default 3)

# --- Grounding & deep execution (optional) ---
QAR_CLAUDE_PATH=claude                       # deep-runner worker binary (default: claude on PATH)
QAR_DEEP_WORKING_DIR=/path/to/your/corpus    # working dir for the subprocess deep-runner (CLI)

# --- Routing & labeling (optional) ---
QAR_DECISION_ASSIGNEE=                       # user id that human-only decisions route to (the default)
QAR_DECISION_ASSIGNEES=                      # NAMED roles for create_decision(assignee="..."): a JSON
                                              # object ({"owner":"user_abc","operator":"user_def"}) or
                                              # name=id,name=id pairs (owner=user_abc,operator=user_def)
QAR_CONTEXT_PREAMBLE=                        # org/persona context prepended to every deep-run brief
QAR_CONTEXT_CARDS_DIR=                       # ContextAssembler cards dir (default <corpus>/.quest-context; empty disables). Gitignore it.
QAR_MAX_CARDS=                               # most cards one local card store holds (default 1000; 0 or unlimited = no limit); at the limit a new topic card is not added and a notice says how to raise it
QAR_RECENT_CONTEXT=                          # 1/true (default) keeps the warm recent-turn card fallback on; 0/false disables it
QAR_RECENT_CONTEXT_MAX_CARDS=                # cap on recent-turn cards let through per turn (default 6)
QAR_RECENT_CONTEXT_GLOBAL=                   # 1/true (default) keeps the "global" (cross-conversation/quest) recent-context scope on; 0/false disables it only
QAR_RUNNER_LABEL=example-runner             # human-readable tag on the env heartbeat
QAR_ENV_ID=                                  # which of the team's envs this runner is (blank = default;
                                            # set a distinct id per runner when a team attaches several)

# --- Web search (optional; ON by default, no extra key needed) ---
# The runner grounds answers on the live web using the model provider's NATIVE tool (Claude's
# web_search / Gemini's Google Search grounding), reusing the LLM key above. Nothing to set to use
# it. Set WEB_SEARCH_ENABLED=false to disable. See docs/how-to/web-search.md.
# WEB_SEARCH_ENABLED=false                    # opt out of web search entirely
# WEB_SEARCH_TIER=balanced                    # model tier for native web search (fast|balanced|quality|best)
# WEB_SEARCH_MAX_RESULTS=5                     # max sources/searches per query
# WEB_SEARCH_API_KEY=tvly_xxx                 # optional: use Tavily instead of native provider search

# --- Runner tuning (optional) ---
QAR_STATE_PATH=qar_state.json               # signature dedup store path
QAR_POLL_INTERVAL=900                        # poll loop cadence, seconds
QAR_MAX_CONSECUTIVE_READS=20                 # planner read-loop limit before escalating to deep
                                            # (default 20; higher = more exploration before escalation)

# --- Resource-aware throttling (optional; all blank = disabled) ---
# When any limit is set, the runner PAUSES picking up new tasks while the host is overloaded and
# resumes automatically once resources recover. Pausing is lossless: unclaimed tasks stay queued
# on the backend and run on a later scan; in-flight tasks are never killed.
QAR_MAX_MEMORY_PERCENT=                      # pause when system memory usage exceeds this % (e.g. 90)
QAR_MIN_FREE_MEMORY_MB=                      # pause when available memory drops below this many MB
QAR_MAX_LOAD_PER_CORE=                       # pause when 1-min load average per CPU core exceeds this (e.g. 2.0)
QAR_RESOURCE_RESUME_MARGIN=10                # hysteresis: clear a tripped limit by this % before resuming
QAR_RESOURCE_CHECK_INTERVAL=30               # seconds between re-checks while paused

# --- Daily token budget (default: 2,000,000 tokens/day) ---
# Caps total shallow API tokens (input + output) per UTC day. Prevents runaway costs from
# indexing and context operations. The deep-runner (Claude Code, subscription) is NOT counted.
# When the limit is hit, the poller pauses and in-flight chat turns return a helpful message.
# Default (unset): 2M tokens/day (~$0.15 Gemini Flash, ~$1.60 Haiku, ~$6 Sonnet).
# Override to raise the cap, or set to 0/"off" to disable entirely.
QAR_DAILY_TOKEN_LIMIT=2000000              # tokens/day; set to 0 or "off" to disable
# QAR_DAILY_USAGE_PATH=qar_daily_usage.json  # where today's count is persisted (gitignored)

# --- Core tunables (optional; the shipped default applies when unset) ---
# `core/` reads no environment variable: these are parsed by the config layer into
# core.runtime_settings.CoreSettings (pin a fixed value with RunnerConfig.core_settings) and re-read
# on every use. The full list of variables is docs/reference/configuration.md.
# QAR_READ_OP_TIMEOUT_SECONDS=60               # per-operation budget for one mid-loop read
# QAR_QUEST_JUDGE_TIMEOUT_SECONDS=8            # quest-selection judgment
# QAR_INTENT_JUDGE_TIMEOUT_SECONDS=8           # intent-directive judgment
# QAR_MODE_RELEASE_TIMEOUT_SECONDS=8           # brainstorm-release judgment (a timeout holds the latch)
# QAR_SOLUTION_CONSIDERATION=0                # 1: chat turns also run per-solution consideration (slower replies)
# QAR_CONTEXT_ASSEMBLY_TIMEOUT_SECONDS=30      # turn-start context assembly
# QAR_GUIDANCE_SELECTION_TIMEOUT_SECONDS=15    # turn-start guidance selection
# QAR_VERIFY_CONTEXT_MAX_CHARS=24000           # cap on the context layer handed to goal verification
# QAR_NOTE_FLOOR_RELEVANCE_GATED=1             # 0 restores the unconditional always-recent notes floor
# QAR_NOTE_FLOOR_FRESH_MINUTES=5               # a note this fresh bypasses the floor's relevance gate
# QAR_DEEP_PROMPT_TOKEN_BUDGET=                # token budget of one deep prompt (capped at the model window)
# QAR_DEEP_TIMEOUT_SECONDS=                    # optional hard cap on a deep run (unset = none)
# QAR_DEEP_REVIEW_INTERVAL_SECONDS=300         # seconds between liveness reviews (0 = off)
# QAR_DEEP_TOOLS=                              # lean deep launch: the only built-in tools (comma list, or none); unset = the CLI default
# QAR_DEEP_SETTING_SOURCES=                    # lean deep launch: user,project,local or none; unset = the CLI default
# QAR_DEEP_STRICT_MCP=                         # lean deep launch: 1 = only the lane's mcp config; unset = ambient servers load too
# QAR_DEEP_EXCLUDE_DYNAMIC_SECTIONS=           # lean deep launch: 1 = per-machine text out of the cached prefix
# QAR_DEEP_MAX_BUDGET_USD=                     # spend ceiling of one deep worker launch (unset = none)
# QAR_DEEP_INSTRUCTIONS_FILES=                 # standing-instruction files (unset = shipped default, empty = none)
# QAR_LINK_POLICY_FILE=                        # link guard policy file

# >>> hub-declared variables: generated by `python -m quest_ai_runner requirements --write-env-example`; do not edit
# Generated by `esoi requirements`; edit the arms' declarations, not this file.
# Fill in the values you have; leave the rest blank.

# Quest API key (secret)
# used by card-store:quest-api-cards, quest-body:quest_client
# required
QUEST_API_KEY=

# variable for option base_url
# used by card-store:quest-api-cards, quest-body:quest_client
# required
# alternatives (any one): QUEST_API_URL
QUEST_BASE_URL=

# variable for option root
# used by delegated-agent-sessions:subprocess
# required
# the one folder the file-editing runner may write in; nothing is writable until you name it
HUBOFHUBS_WRITE_ROOT=

# variable for option root
# used by file-editing:files
# required
QAR_CORPUS_ROOT=

# variable for option team_id
# used by quest-body:quest_client
# optional
QUEST_TEAM_ID=

# variable for option token_file
# used by intake-sources:openclaw
# required
QAR_OPENCLAW_TOKEN_FILE=

# Anthropic API key (secret)
# used by vendor-model-caller:anthropic
# signup: https://platform.claude.com/
# docs: https://platform.claude.com/docs/en/api/rate-limits
# pricing: https://platform.claude.com/docs/en/about-claude/pricing
# rate limit: limits are set per organization by usage tier (requests, input tokens and output tokens a minute per model), with a monthly spend cap per tier; new organizations may start on a lower Evaluation tier (as of 2026-10-31)
# required
ANTHROPIC_API_KEY=

# DeepSeek API key (secret)
# used by vendor-model-caller:deepseek
# signup: https://platform.deepseek.com/
# docs: https://api-docs.deepseek.com/
# pricing: https://api-docs.deepseek.com/quick_start/pricing
# rate limit: concurrency limits of 2,500 (deepseek-flash) and 500 (deepseek-v4-pro) (as of 2026-10-31)
# required
DEEPSEEK_API_KEY=

# variable for option base_url
# used by vendor-model-caller:deepseek
# optional
DEEPSEEK_BASE_URL=

# Gemini API key (secret)
# used by vendor-model-caller:gemini
# signup: https://aistudio.google.com/apikey
# docs: https://ai.google.dev/gemini-api/docs
# pricing: https://ai.google.dev/gemini-api/docs/pricing
# free tier: a free plan for developers and small projects (some models are not on it); Google Search grounding free allowance: 500 requests a day shared by Gemini 2.5 Flash and Flash-Lite; 5,000 a month shared by Gemini 3 and newer models (as of 2026-10-31)
# rate limit: Gemini 3 and newer: a default cap of 1,500 grounded requests a day per project (as of 2026-10-31)
# required
# alternatives (any one): GEMINI_API_KEY, GOOGLE_AI_API_KEY
GOOGLE_API_KEY=

# secret variable for option api_key
# used by vendor-model-caller:openai
# required
OPENAI_API_KEY=

# variable for option base_url
# used by vendor-model-caller:openai
# required
OPENAI_BASE_URL=
# <<< hub-declared variables
