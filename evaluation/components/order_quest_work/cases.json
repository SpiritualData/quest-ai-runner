 {
  "id": "quest-member-ranks-team-quest-above-own",
  "kind": "quest-list",
  "origin": "rule: a person's own entry in priority_by_user decides, whoever created the quest",
  "source": "quest-backend tests/business/test_accessible_quests.py",
  "args": {
   "person": "member",
   "candidates": [
    {
     "id": "member-quest",
     "kind": "quest",
     "owner": "member",
     "rank_by_person": {
      "member": 1
     }
    },
    {
     "id": "team-quest",
     "kind": "quest",
     "owner": "creator",
     "rank_by_person": {
      "member": 0
     }
    }
   ],
   "now": "2026-07-12T09:00:00Z"
  },
  "expect": [
   "team-quest",
   "member-quest"
  ]
 },
