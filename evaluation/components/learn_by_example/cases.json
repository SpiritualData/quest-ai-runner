 {
  "id": "EXM-013",
  "area": "run",
  "kind": "run",
  "description": "custom_consumer reports what is missing instead of crashing, on an empty environment",
  "args": {
   "file": "custom_consumer.py"
  },
  "expect": {
   "eq": {
    "exit": 0
   },
   "contains": [
    "RunnerConfig is incomplete",
    "quest_base_url is required"
   ]
  }
 },
 {
  "id": "EXM-014",
  "area": "run",
  "kind": "run",
  "description": "custom_consumer with a base URL, key and corpus reports its identity",
  "args": {
   "file": "custom_consumer.py",
   "env": {
    "QUEST_BASE_URL": "https://api.example.org",
    "QUEST_API_KEY": "qsk_example",
    "QUEST_TEAM_ID": "team_example"
   }
  },
  "expect": {
   "eq": {
    "exit": 0
   },
   "contains": [
    "team_id='team_example'",
    "base_url='https://api.example.org'"
   ]
  }
 },
 {
  "id": "EXM-015",
  "area": "run",
