[
 {"id": "STL-001", "area": "edit",
  "files": {"a.py": "x = 1\n", "b.py": "y = 2\n", "c.py": "z = 3\n", "d.py": "w = 4\n"},
  "ops": [{"op": "write", "path": "a.py", "content": "x = 1\n# edited\n"},
          {"op": "write", "path": "b.py", "content": "y = 2\n# edited\n"},
          {"op": "write", "path": "c.py", "content": "z = 3\n# edited\n"}],
  "expect_changed": ["a.py", "b.py", "c.py"]},
 {"id": "STL-002", "area": "no_change",
  "files": {"a.py": "x = 1\n", "b.py": "y = 2\n"},
  "ops": [],
  "expect_changed": []},
 {"id": "STL-003", "area": "witness",
  "files": {"a.py": "x = 1\n", "b.py": "y = 2\n", "c.py": "z = 3\n"},
  "ops": [{"op": "write", "path": "a.py", "content": "x = 2\n"}],
  "expect_changed": ["a.py"]},
 {"id": "STL-004", "area": "touch_only",
  "files": {"a.py": "x = 1\n", "b.py": "y = 2\n"},
  "ops": [{"op": "touch", "path": "a.py"}],
  "expect_changed": []},
 {"id": "STL-005", "area": "same_size_edit",
  "files": {"a.py": "limit = 100\n", "b.py": "y = 2\n"},
  "ops": [{"op": "same_size_edit", "path": "a.py", "content": "limit = 900\n"}],
  "expect_changed": ["a.py"]},
 {"id": "STL-006", "area": "deletion",
  "files": {"a.py": "x = 1\n", "b.py": "y = 2\n"},
  "ops": [{"op": "delete", "path": "a.py"}],
  "expect_changed": ["a.py"]}
]
