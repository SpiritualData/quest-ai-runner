  "area": "each goal goes to the autopilot the judge names",
  "args": {
   "goals": [
    {
     "id": "g1",
     "name": "Draft chapter three",
     "ai_help": true,
     "completed": false
    },
    {
     "id": "g2",
     "name": "Find sources for chapter three",
     "ai_help": true,
     "completed": false
    }
   ],
   "duty": [
    {
     "id": "ap-w",
     "name": "Writer",
     "purpose": "Writes the book.",
     "instructions": "Draft and edit chapters."
    },
    {
     "id": "ap-r",
     "name": "Researcher",
     "purpose": "Finds sources.",
     "instructions": "Research and cite sources."
    }
   ],
   "judge": {
    "g1": "ap-w",
    "g2": "ap-r"
   }
  },
  "expect": {
   "eq": {
    "assignments": {
     "g1": "ap-w",
     "g2": "ap-r"
    }
   }
  },
  "heldout": false
 },
