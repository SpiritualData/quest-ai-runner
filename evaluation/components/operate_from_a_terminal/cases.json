 {
  "id": "CLI-035",
  "kind": "run_cli",
  "area": "cli",
  "args": {
   "entry": "tools",
   "argv": [
    "list"
   ],
   "env": {
    "QAR_TOOLS_FILE": "{dir}/tools.toml"
   },
   "files": {
    "tools.toml": "[[tool]]\nname = \"make_note\"\ndescription = \"File a note for review.\"\nwhen_to_use = \"Anything worth remembering.\"\nwhen_not_to_use = \"Secrets.\"\ncommand = [\"{python}\", \"{dir}/note.py\", \"create\"]\n[tool.parameters]\ntype = \"object\"\nrequired = [\"subject\"]\n[tool.parameters.properties.subject]\ntype = \"string\"\n",
    "note.py": "import json, sys\nprint(json.dumps({'argv': sys.argv[1:]}))\n"
   }
  },
  "expect": {
   "eq": {
    "exit": 0
   },
   "contains": [
    "make_note"
   ]
  }
 },
