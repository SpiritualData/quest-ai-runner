[
 {
  "id": "GRD-001",
  "kind": "link_sanitize",
  "area": "links",
  "args": {
   "text": "See [your tasks](/profile/ai-tasks) and [the dashboard](/profile/dashboard).",
   "policy": {
    "routes": [
     "/profile/ai-tasks",
     "/quest/[questId]/chat",
     "/quest"
    ],
    "origins": [
     "app.example.org"
    ],
    "trusted_hosts": [
     "docs.example.org"
    ],
    "allowed_schemes": [
     "app-task"
    ],
    "rewrites": [
     {
      "match": "https://api\\.example\\.org/api/tasks/(\\w+)",
      "replace": "app-task:\\1"
     }
    ]
   },
   "fetch": {
    "https://real.example.com/page": [
     200,
     ""
    ],
    "https://gated.example.com/x": [
     403,
     ""
    ],
    "https://gone.example.com/old": [
     404,
     ""
    ],
    "https://nohost.invalid/x": [
     null,
     "dns"
    ],
    "https://slow.example.com/y": [
     503,
     "server error"
    ]
   }
  },
  "expect": {
   "contains": [
    "[your tasks](/profile/ai-tasks)",
    "the dashboard (link removed: that address does not exist)"
   ],
   "not_contains": [
    "/profile/dashboard"
   ],
   "eq": {
    "verdicts": {
     "/profile/ai-tasks": "ok",
     "/profile/dashboard": "dead"
    }
   }
  }
 },
