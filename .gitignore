__pycache__/
*.py[cod]
*.egg-info/

# Throwaway / scratch / demo scripts (see CLAUDE.md Conventions) — never committed
scratch/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# Local runner state (signature dedup store + daily token usage)
qar_state.json
*_state.json
qar_daily_usage.json

# ContextAssembler cards (FileContextStore) — machine-written, mutate every run, rebuildable.
# Treat as local state, not source: inspectable/diffable locally but not committed. Promote
# durable knowledge to a committed CLAUDE.md context-map instead. A consumer may set cards_dir
# elsewhere (e.g. from an env var) and gitignore that path in their own repo.
.quest-context/

# Local secrets / consumer config — never commit
.env
.env.*
!.env.example
